# Linux release image for DonutRadio: Ubuntu 22.04 (glibc 2.35 floor, as DonutStudio),
# Qt from aqtinstall, and the tools to build ECM, Kirigami, FFmpeg and the AppImage.
FROM ubuntu:22.04
ARG QT_VERSION
ARG AQT_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git curl ca-certificates xz-utils file \
      python3 python3-pip pkg-config nasm patchelf zip \
      libgl1-mesa-dev libegl1-mesa-dev libxkbcommon-dev libxkbcommon-x11-0 libfontconfig1-dev \
      libfreetype6-dev libdbus-1-dev libpulse-dev libglib2.0-0 \
      libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
      libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libwayland-client0 \
      libwayland-cursor0 libwayland-egl1 \
 && rm -rf /var/lib/apt/lists/*
# aqt renamed the Linux arch from gcc_64 to linux_gcc_64 in later Qt releases; ask it.
RUN pip3 install --no-cache-dir "aqtinstall==${AQT_VERSION}" \
 && arch="$(aqt list-qt linux desktop --arch "${QT_VERSION}" | tr ' ' '\n' | grep -E '^(linux_)?gcc_64$' | head -1)" \
 && aqt install-qt linux desktop "${QT_VERSION}" "$arch" -m qtshadertools -O /opt/Qt \
 && test -x "/opt/Qt/${QT_VERSION}/gcc_64/bin/qmake"
ENV QT_ROOT=/opt/Qt/${QT_VERSION}/gcc_64
WORKDIR /src
